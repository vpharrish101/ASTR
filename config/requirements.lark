start: NAME ":" clause "->" NAME

?clause: "when" expression
       | "otherwise" -> otherwise

?expression: conjunction ("or" conjunction)+ -> any_of
           | conjunction
?conjunction: atom ("and" atom)+ -> all_of
            | atom
?atom: NAME "is" PRESENCE -> presence
     | NAME OP value      -> compare
     | "(" expression ")"

?value: INT UNIT       -> duration
      | ESCAPED_STRING
      | BOOL

OP: "==" | ">=" | "<=" | ">" | "<"
UNIT: "sec" | "min"
PRESENCE: "missing" | "present"
BOOL: "true" | "false"

%import common.CNAME -> NAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
